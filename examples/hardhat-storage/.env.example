# URL del relayer (el proxy JSON-RPC, no el nodo directo).
RELAYER_URL=http://localhost:3000

# Clave del usuario final. NO necesita fondos ni permisos: solo firma la metatx.
# Si se deja vacia el script genera una cuenta al vuelo.
USER_PRIVATE_KEY=

# Address del writer node. Vacio => se pregunta a GET /info del relayer.
NODE_ADDRESS=

# Segundos de validez de la metatx.
EXPIRATION_SECONDS=86400
