# ---------- relayer ----------
PORT=3000

# JSON-RPC CRUDO del nodo Besu (no el endpoint del relay-signer oficial: ese intercepta
# eth_sendRawTransaction esperando una metatx y rechazaria las tx de este relayer).
# lnet mainnet (endpoint publico, sirve para lectura): http://34.73.228.200
RPC_URL=http://127.0.0.1:8545

# Clave del writer node que relaya. Tiene que estar dada de alta en el hub (addNode)
# y tener cupo de gas por bloque, si no las metatx salen con NotEnoughGas.
NODE_PRIVATE_KEY=0x...

# Direccion del RelayHub. Si la dejas vacia se resuelve con getRelayHub() sobre el proxy.
# lnet mainnet: proxy 0xEAA5420AF59305c5ecacCB38fcDe70198001d147 -> hub 0x34B220Ef63dea567eDf6d540316B5a3f4831Cf6c
# open-protestnet: proxy 0xa4B5eE2906090ce2cDbf5dfff944db26f397037D
RELAY_HUB_ADDRESS=
RELAY_HUB_PROXY_ADDRESS=0xEAA5420AF59305c5ecacCB38fcDe70198001d147

# Validaciones (poner en false solo para depurar)
SIMULATE_BEFORE_SEND=true
ENFORCE_NODE_ADDRESS=true
ENFORCE_EXPIRATION=true

# Ventana minima que le tiene que quedar a la metatx cuando llega, en segundos. Una expiration al
# filo no sirve: entre validar, simular, esperar el turno del nonce y minar pasan segundos, y si
# vence en el medio la metatx se pierde habiendo gastado una tx del writer node.
# Menos que esto se rechaza con EXPIRATION_TOO_LOW. Solo aplica con ENFORCE_EXPIRATION=true.
MIN_EXPIRATION_SECONDS=300

# Tolerancia con la que se aplica ese minimo: el piso real es MIN_EXPIRATION_SECONDS menos esto.
# Quien firma `ahora + 300` llega con 299 o 298 (la latencia del POST y el floor a segundos de cada
# lado), y no tiene sentido rechazar justo al cliente que firmo el minimo pedido. Subirla si la red
# es mas lenta; 0 exige el valor exacto.
EXPIRATION_LATENCY_TOLERANCE_SECONDS=2

# ---------- permissioning de cuentas (AccountRules) ----------
# El relayer chequea al arrancar que el writer node este dado de alta en AccountRules: si no lo
# esta, el nodo rechaza todos los relayMetaTx con "not authorized". Eso pasa siempre, sin config.
#
# Esto de aca exige ADEMAS que el USUARIO de la metatx este permisionado (es lo que hace el
# relay-signer en Go). Apagado por defecto: en el modelo de gas de LAC-NET los usuarios no tienen
# por que estar dados de alta -- prenderlo convierte AccountRules en el allowlist del relayer.
ENFORCE_ACCOUNT_RULES=false

# AccountRules directo. Vacio => se resuelve con AccountIngress.getContractAddress("rules").
# lnet mainnet: 0x571d20db5f86FA53133D2c36A51a2ba731eC51B4
# open-protestnet: 0x23F99e888146FEE4A33aa330b7D1B2083de9F386
ACCOUNT_RULES_ADDRESS=

# AccountIngress (registry del permissioning de Besu). El default es el de LACChain y sirve en
# mainnet y en protestnet. Definirla vacia desactiva la resolucion (cadena sin permissioning).
ACCOUNT_INGRESS_ADDRESS=0x0000000000000000000000000000000000008888

# Cuanto se cachea accountPermitted(). Sin cache es un eth_call extra por metatx; con cache, dar
# de alta una cuenta tarda hasta esto en verse.
ACCOUNT_RULES_CACHE_MS=30000

# ---------- concurrencia ----------
# Metatx del mismo usuario que pueden estar en vuelo a la vez (enviadas y sin receipt).
# Es lo que permite meter varias metatx de un usuario en el mismo bloque. Acota el dano si
# la cadena de nonces se rompe: las posteriores a la que falla las rechaza el hub, y cada
# una gasta una tx del writer node.
MAX_INFLIGHT_PER_USER=16

# Cuanto espera una metatx que llego adelantada a que se cierre el hueco de nonces.
# Sobre HTTP el orden de llegada no esta garantizado y el hub exige el nonce exacto.
# Mide ESTANCAMIENTO, no espera total: se renueva cada vez que la cadena avanza, asi que una rafaga
# larga no pierde la cola por reloj mientras el hub siga avanzando.
REORDER_WINDOW_MS=3000

# Techo de espera del receipt. Vencido se responde RECEIPT_TIMEOUT en vez de colgarse.
RECEIPT_TIMEOUT_MS=60000

# Origen permitido por CORS en el proxy JSON-RPC, para dapps de browser.
# Vacio desactiva las cabeceras (si hay un gateway adelante que ya las pone).
CORS_ORIGIN=*

# ---------- autenticacion ----------

# Secreto compartido que exigen los endpoints que gastan gas: POST /relay, el JSON-RPC y el
# WebSocket. Vacio los deja abiertos, razonable en localhost. En una URL publica, vacio significa
# que cualquiera que la encuentre gasta el gas del writer node.
#   HTTP      -> Authorization: Bearer <secreto>
#   WebSocket -> ?token=<secreto> en la URL (el WS del browser no manda cabeceras en el handshake)
# Generar uno con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
RELAY_API_SECRET=

# ---------- websocket ----------
# WS del nodo para eth_subscribe. Vacio => se deriva del RPC (mismo host, puerto + 1),
# que es la convencion de Besu (8545/8546, 4545/4546).
# Si el nodo no expone WS, eth_subscribe da un error claro y el resto del proxy sigue andando.
WS_URL=

# Techo para abrir el WS del nodo. Sin esto se cae en el timeout de TCP del SO (~75 s).
WS_CONNECT_TIMEOUT_MS=10000

# ---------- cliente de ejemplo ----------
RELAYER_URL=http://localhost:3000
USER_PRIVATE_KEY=0x...
TARGET_ADDRESS=0x...
EXPIRATION_SECONDS=86400
